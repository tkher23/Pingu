{
  "manifest_version": 3,
  "name": "Pingu",
  "version": "1.0",
  "description": "Generate personalized outreach emails!",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "https://pingu-login.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Pingu"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "externally_connectable": {
    "matches": ["https://pingu-login.vercel.app/*"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
  "128": "icon.png"
}
}
