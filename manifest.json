{
  "manifest_version": 3,
  "name": "My Supabase Extension",
  "description": "An extension with Supabase OAuth login",
  "version": "1.0.0",
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "dist/background.bundle.js"
  }
}