{
  "manifest_version": 3,
  "name": "Pingu",
  "version": "1.0",
  "description": "Generate personalized internship outreach emails",
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://ishnglghmfijbgtuhxzd.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["oauth-callback.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "side_panel": {
    "default_path": "popup.html"
  }
}
